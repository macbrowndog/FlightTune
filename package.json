{
  "name": "flighttune",
  "version": "1.1.1",
  "private": true,
  "author": "Andrew Brown",
  "description": "Native Windows hardware-aware MSFS 2024 UserCfg.opt optimizer",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "dist:win": "pnpm run build && electron-builder --win nsis",
    "test": "node --test tests/config-file.test.cjs",
    "test:hardware": "powershell -NoProfile -ExecutionPolicy Bypass -File electron/detect-hardware.ps1"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "wait-on": "9.0.3"
  },
  "build": {
    "appId": "com.flighttune.msfs2024",
    "productName": "FlightTune",
    "asar": true,
    "asarUnpack": [
      "electron/detect-hardware.ps1"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "FlightTune-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
